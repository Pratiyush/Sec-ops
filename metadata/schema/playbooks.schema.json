{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secops.local/schema/playbooks.schema.json",
  "title": "Playbooks manifest",
  "type": "object",
  "required": ["version", "playbooks"],
  "properties": {
    "version": { "type": "string" },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "tier"],
        "properties": {
          "id":      { "type": "string" },
          "version": { "type": "string" },
          "tier":    { "type": "string", "enum": ["T0", "T1", "T2", "T3"] },
          "promotionCandidate": { "type": "string", "enum": ["T0", "T1", "T2", "T3"] },
          "uses":         { "type": "integer", "minimum": 0 },
          "successRate":  { "type": "number", "minimum": 0, "maximum": 1 },
          "cwes":   { "type": "array", "items": { "type": "string" } },
          "stack":  { "type": "array", "items": { "type": "string" } },
          "owners": { "type": "array", "items": { "type": "string" } },
          "policy": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
